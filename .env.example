TINVEST_TOKEN=
TINVEST_ACCOUNT_ID=
INSTRUMENT_MODE=protective
PREFERRED_INSTRUMENTS=SBER:TQBR,GAZP:TQBR
REQUEST_TIMEOUT=15s
QUOTE_MAX_AGE=30m

# Stage 2: analysis and durable history (never sends orders)
POSTGRES_USER=ai_trader
POSTGRES_DB=ai_trader
POSTGRES_PASSWORD=replace-with-a-random-local-password
# Used inside Compose; for host Go runs use localhost after configuring port forwarding.
POSTGRES_HOST=postgres:5432
# Optional full DSN overrides POSTGRES_* (do not commit credentials).
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT=90s
OPENAI_MAX_OUTPUT_TOKENS=2048

# Use the host's existing `codex login` with ChatGPT, no OPENAI_API_KEY needed.
AI_PROVIDER=codex_cli
CODEX_BINARY=codex
# Empty = CLI built-in default; independent of OPENAI_MODEL.
CODEX_MODEL=
CODEX_TIMEOUT=180s
POSTGRES_PORT=54329

# Market context and risk preview
CANDLE_LIMIT=24
MARKET_MAX_AGE=60s
RISK_SLIPPAGE_BPS=20

# Economy: quota is per account across providers/models, Moscow calendar day.
# Explicit analyze --refresh bypasses quota/cache, never safety gates.
AI_DAILY_CALL_LIMIT=2
AI_CACHE_TTL=10m
AI_MAX_INPUT_BYTES=32768

# Allow automation to execute its own fresh BUY/SELL proposals in Sandbox.
AUTOMATION_EXECUTE_ORDERS=false

# Optional outbound notifications. No incoming bot/trading commands.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Read by backup scripts from the process environment (systemd loads .env).
# Optional BACKUP_DIR defaults to <project>/.backups; do not commit dumps.
BACKUP_KEEP=14
